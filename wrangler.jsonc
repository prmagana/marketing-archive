{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "marketing",
  "main": ".open-next/worker.js",
  "workers_dev": false,
  // Custom domains like root: the zone had no apex records, so Cloudflare manages the DNS and cert itself.
  "routes": [
    { "pattern": "tapt.marketing", "custom_domain": true },
    { "pattern": "www.tapt.marketing", "custom_domain": true }
  ],
  "compatibility_date": "2026-10-27",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
